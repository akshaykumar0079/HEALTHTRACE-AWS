# Copy to .env and fill in as needed. The app must run fully with none of this set.

# -- Email alerts (no AWS needed) ---------------------------------------------
# HIGH and CRITICAL incidents are emailed once when opened and once per
# escalation. Easiest: run `python scripts/setup_email.py`, which fills in the
# Brevo lines below for you (key typed hidden) and sends a test email.
EMAIL_ENABLED=false
# brevo (recommended: one API key, HTTPS) or smtp (e.g. Gmail + App Password)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Brevo: the email you signed up with (a verified sender). SMTP: defaults to SMTP_USERNAME.
ALERT_EMAIL_FROM=
# Comma-separated list allowed.
ALERT_EMAIL_TO=vasan.akxy@gmail.com
# Optional: adds an "Open in HEALTHTRACE" link to each email.
# DASHBOARD_URL=http://localhost:5173
# Only for EMAIL_PROVIDER=smtp:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# -- AWS (optional) -----------------------------------------------------------
# off | mock | live (SPEC.md section 6.9). The local demo needs no AWS: use off or mock.
# Never put AWS access keys here: in live mode boto3 uses its default chain
# (AWS_PROFILE / `aws configure` / SSO locally, the task role on ECS).
AWS_MODE=off
AWS_REGION=us-east-1
# Also accepted as AWS_LOG_GROUP / AWS_SNS_TOPIC_ARN.
CLOUDWATCH_LOG_GROUP=/medguard/alerts
# Fixed stream name (also AWS_LOG_STREAM). Empty = one stream per UTC day.
CLOUDWATCH_LOG_STREAM=
SNS_TOPIC_ARN=

# Enables POST /api/demo/inject and the frontend demo panel.
DEMO_MODE=true

# Paths default to <repo root>/data/{logs,medguard.db,control.json} and only
# need overriding for a non-standard layout. Use absolute paths if you do.
# LOG_DIR=
# DB_PATH=
# CONTROL_FILE=

# Shown in the UI; one deployment watches one project environment.
PROJECT_NAME=Medicaid Pipeline
ENVIRONMENT=local
# Browser origins allowed cross-origin (not needed when the UI is served by the backend).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# When set, acknowledge/resolve/mute/demo/AWS-test endpoints require X-Operator-Token.
OPERATOR_TOKEN=

# -- Database ------------------------------------------------------------------
# Empty = local SQLite at DB_PATH. For hosting, a PostgreSQL URL (e.g. Neon free):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# -- Notifications / flood control ----------------------------------------------
EMAIL_MIN_SEVERITY=HIGH
EMAIL_COOLDOWN_SECONDS=300

# -- Data source label ----------------------------------------------------------
# simulated (default; the UI shows a SIMULATED DATA badge) | real
DATA_SOURCE=simulated

# -- Hosting extras ---------------------------------------------------------------
# Refuse writes unless OPERATOR_TOKEN is set and sent (default on when ENVIRONMENT=production).
# REQUIRE_OPERATOR_TOKEN=true
# Run the synthetic generator inside the backend (single-service hosts have no sidecar).
EMBEDDED_GENERATOR=false
# EMBEDDED_RATE=10
# EMBEDDED_BACKFILL_HOURS=2
# Persist at most one metric row per service per N seconds (0 = every window).
METRICS_PERSIST_INTERVAL_SECONDS=0
# PORT is injected by the host (Render); default 8000.

# -- Frontend build-time (set on Vercel, not here) --------------------------------
# VITE_API_BASE_URL=https://<your-backend-host>
# VITE_WS_URL=wss://<your-backend-host>/ws

# --- Roles, privacy and retention (docs/privacy-and-retention.md) ---
# Role tokens are sent as the X-Operator-Token header. Leave empty locally; set
# strong random values (e.g. `openssl rand -hex 32`) before exposing the API.
VIEWER_TOKEN=
ADMIN_TOKEN=
# REQUIRE_VIEW_AUTH=true     # require a token even to read
# REDACTION_ENABLED=true
# RETENTION_RESOLVED_INCIDENTS_DAYS=90   # 0 keeps forever
